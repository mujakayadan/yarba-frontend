# Copy to `.env.local` for local development.
# Never commit real credentials — see SECURITY.md.

# Native Android emulator rewrites localhost → 10.0.2.2. Use a public HTTPS API for device builds.
# Staging/production native: copy `.env.native-staging.example` or `.env.native-production.example`.
VITE_API_URL=http://localhost:8000/api/v1
VITE_CLOUDFRONT_URL=https://your-cloudfront-domain/
VITE_DEBUG=true
# Web client ID. Used by Google Identity Services on the web and as webClientId for
# Capacitor Google (Capgo / Credential Manager) on Android and iOS.
# Must match backend OAUTH_GOOGLE_WEB_AUDIENCES.
# The Android OAuth client is not an env var. Create it in Google Cloud Console for
# package com.yarba.app plus the signing-certificate SHA-1.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Web Apple JS only. The native app does not show Apple until iOS Sign in with Apple ships.
VITE_APPLE_SERVICE_ID=com.example.yarba.web
VITE_APPLE_REDIRECT_URI=http://localhost:3000/login
