# Copy to `.env.local` for local development.
# Never commit real credentials — see SECURITY.md.

VITE_API_URL=http://localhost:8000/api/v1
VITE_CLOUDFRONT_URL=https://your-cloudfront-domain/
VITE_DEBUG=true
VITE_NATIVE_AUTH=false
VITE_NATIVE_OAUTH=false
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_APPLE_SERVICE_ID=com.example.yarba.web
VITE_APPLE_REDIRECT_URI=http://localhost:3000/login

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
