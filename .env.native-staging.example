# Copy to `.env.native-staging.local` (gitignored). Used by `npm run cap:sync:staging`.
# Never commit real credentials — see SECURITY.md.

VITE_API_URL=https://your-staging-api.example/api/v1
VITE_CLOUDFRONT_URL=https://your-cloudfront-domain/
VITE_DEBUG=true
# Web client ID for web GIS and Capacitor Google (Capgo / Credential Manager).
# Android OAuth client: Google Cloud Console only, package com.yarba.app + SHA-1.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Web Apple JS only. Hidden in the native app.
VITE_APPLE_SERVICE_ID=com.example.yarba.web
VITE_APPLE_REDIRECT_URI=https://your-staging-web.example/login
