{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "github": {
    "silent": true
  },
  "env": {
    "VITE_DEBUG": "false",
    "VITE_FIREBASE_PROJECT_ID": "yarba-app"
  }
}
